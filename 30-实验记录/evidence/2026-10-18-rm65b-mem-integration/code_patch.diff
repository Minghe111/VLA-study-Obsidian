+def test_strict_memory_requires_read_and_explicit_evidence_state():
+    memory = EpisodeMemory(
+        {"a": "location", "b": "other"}, "0", "ep", strict_protocol=True
+    )
+    operation = {"op": "WRITE", "slot_id": "a", "value": "left", "confirmed": False}
+    source = {"kind": "actor_generated", "step": 0}
+    with pytest.raises(ValueError, match="READ"):
+        memory.apply(operation, source=source)
+    memory.read(["a"])
+    with pytest.raises(ValueError, match="explicit confirmed"):
+        memory.apply(
+            {k: v for k, v in operation.items() if k != "confirmed"}, source=source
+        )
+    with pytest.raises(ValueError, match="non-visible"):
+        memory.apply(operation, source={**source, "task_events": []})
+    with pytest.raises(ValueError, match="future"):
+        memory.apply(operation, source={**source, "observed_until_step": 1})
+    memory.apply(operation, source=source)
+    memory.apply(
+        {"op": "CORRECT", "slot_id": "a", "value": "held", "confirmed": False},
+        source=source,
+    )
+    assert memory.actor_view(["a"], ["a"])["selected"][0]["value"] == "held"
+    restored = EpisodeMemory.from_dict(memory.to_dict())
+    assert restored.to_dict() == memory.to_dict()
+    memory.read(["b"])
+    with pytest.raises(ValueError, match="READ"):
+        memory.apply({"op": "KEEP", "slot_id": "a", "confirmed": False}, source=source)
+
