+def batch(model):
+    observation = model._config.fake_obs()
+    target = torch.tensor([[5, 6, 1]])
+    return {
+        "high_observation": observation,
+        "high_target_ids": target,
+        "high_loss_mask": torch.ones_like(target, dtype=torch.bool),
+        "fast_observation": observation,
+        "fast_target_ids": target + 2,
+        "fast_loss_mask": torch.ones_like(target, dtype=torch.bool),
+        "action_observation": observation,
+        "actions": torch.ones(1, 2, 4),
+        "noise": torch.zeros(1, 2, 4),
+        "time": torch.tensor([0.5]),
+    }
