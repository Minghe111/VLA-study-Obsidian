+def test_dense_history_samples_actual_clock_and_masks_missing_past():
+    ring = CausalObservationHistory(env_id="0", episode_id="ep")
+    native = ExternalClockedEnvironment.observation()
+    for step in range(25):
+        reference = {"npz_path": f"{step}.npz"}
+        ring.append(
+            native, reference, physics_step=step * 15, env_id="0", episode_id="ep"
+        )
+        window = ring.window(references=True)
+        validate_history_reference(window, current_physics_step=step * 15)
+        if step == 0:
+            assert window["valid_mask"] == [False, False, False, True]
+    assert window["physics_steps"] == [0, 120, 240, 360]
+    assert window["age_s"] == [1.44, 0.96, 0.48, 0]
+    with pytest.raises(ValueError, match="owner"):
+        ring.append(native, reference, physics_step=375, env_id="0", episode_id="other")
+    with pytest.raises(ValueError, match="advance"):
+        ring.append(native, reference, physics_step=360, env_id="0", episode_id="ep")
+    with pytest.raises(ValueError, match="skip"):
+        ring.append(native, reference, physics_step=390, env_id="0", episode_id="ep")
