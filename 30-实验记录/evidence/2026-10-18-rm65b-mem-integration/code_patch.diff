+        action_obs = prompt_observation(probe_base, action_text)
+        full_action_obs = prompt_observation(full_base, action_text)
+
+        def video_forward():
+            prepared = preprocess_observation(full_action_obs, train=False)
+            with torch.no_grad():
+                prefix, mask, _ = model.embed_prefix(prepared)
+                actions, _ = model._predict_eval(full_action_obs, noise=noise())
+            assert actions.shape == (1, 16, 24) and torch.isfinite(actions).all()
+            assert (
+                prefix.shape[1] == 768 + 3 + full_action_obs.tokenized_prompt.shape[1]
+            )
+            np.save(args.output / "video_actions.npy", actions.float().cpu().numpy())
+            return {
+                "prefix_shape": list(prefix.shape),
