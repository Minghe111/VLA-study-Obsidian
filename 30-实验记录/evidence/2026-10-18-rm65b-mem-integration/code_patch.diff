+"""Read the original native SFT entry and save deterministic reference actions."""
+
+import argparse
+import hashlib
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from omegaconf import OmegaConf
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--episode", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output = args.output.resolve()
+    args.output.mkdir(parents=True, exist_ok=False)
+    import rlinf.models.embodiment.openpi as original
+
+    if "rlinf_local_5090_minppo_20261013/code/RLinf" not in original.__file__:
+        raise RuntimeError("Baseline must import the retained original native code")
+    cfg = yaml.safe_load(args.config.read_text())
+    cfg["model"]["openpi"]["task"] = "eval"
+    episode = json.loads(args.episode.read_text())
+    references = [episode["steps"][i]["observation"] for i in (0, 12)]
+    references.append(episode["steps"][-1]["next_observation"])
+    torch.set_num_threads(4)
+    torch.manual_seed(20261018)
+    started = time.monotonic()
+    model = original.get_model(OmegaConf.create(cfg["model"])).to("cuda:0").eval()
+    actions, details = {}, []
+    for index, reference in enumerate(references):
+        with np.load(reference["npz_path"], allow_pickle=False) as archive:
+            io = {
+                "main_images": archive["full_image"][None],
+                "wrist_images": np.stack(
+                    [archive["left_wrist_image"], archive["right_wrist_image"]]
+                )[None],
+                "states": archive["state"][None],
+                "task_descriptions": [cfg["rollout"]["goal"]],
+            }
+        observation = model.env_obs_to_observation(io)
+        noise = torch.randn(
+            (1, 16, 32),
+            device="cuda:0",
+            generator=torch.Generator(device="cuda:0").manual_seed(20261018),
+        )
+        with torch.no_grad():
+            output, _ = model._predict_eval(observation, noise=noise)
+        value = output.float().cpu().numpy()
+        assert value.shape == (1, 16, 24) and np.isfinite(value).all()
+        actions[f"actions_{index}"] = value
+        details.append(
+            {
+                "observation": reference["npz_path"],
+                "action_sha256": hashlib.sha256(value.tobytes()).hexdigest(),
+            }
+        )
+    np.savez_compressed(args.output / "actions.npz", **actions)
+    report = {
+        "passed": True,
+        "original_module": original.__file__,
+        "cases": details,
+        "training": False,
+        "optimizer_steps": 0,
+        "elapsed_s": time.monotonic() - started,
+        "peak_allocated_mib": torch.cuda.max_memory_allocated() / 2**20,
+    }
+    (args.output / "report.json").write_text(json.dumps(report, indent=2))
+    print(json.dumps(report), flush=True)
+
+
+if __name__ == "__main__":
+    main()
