+"""Episode-owned causal RGB/state windows using measured physics timestamps."""
+
+from collections import deque
+from copy import deepcopy
+
+import numpy as np
+
+CAMERAS = ("full_image", "left_wrist_image", "right_wrist_image")
+HISTORY_VERSION = "rm65b_mem_history_v1"
+
+
+class CausalObservationHistory:
+    """Own a dense history and expose sparse windows without future frames."""
+
+    def __init__(
+        self,
+        *,
+        env_id: str,
+        episode_id: str,
+        num_frames: int = 4,
+        stride_steps: int = 8,
+        physics_steps_per_action: int = 15,
+        physics_dt_s: float = 0.004,
+    ) -> None:
+        if (
+            not env_id
+            or not episode_id
+            or type(num_frames) is not int
+            or num_frames < 1
+            or type(stride_steps) is not int
+            or stride_steps < 1
+            or physics_steps_per_action != 15
+            or physics_dt_s != 0.004
+        ):
+            raise ValueError("MEM history requires an episode and the SDK24/60ms clock")
+        self.env_id, self.episode_id = env_id, episode_id
+        self.num_frames, self.stride_steps = num_frames, stride_steps
+        self.physics_dt_s = physics_dt_s
+        self.stride_ticks = stride_steps * physics_steps_per_action
+        self._frames: deque = deque(maxlen=(num_frames - 1) * stride_steps + 2)
+
+    def append(
+        self,
+        observation: dict,
+        reference: dict,
+        *,
+        physics_step: int,
+        env_id: str,
+        episode_id: str,
+    ) -> None:
+        """Append exactly one actual observation from this owner's clock."""
+        if (env_id, episode_id) != (self.env_id, self.episode_id):
+            raise ValueError("MEM history owner differs from the environment/episode")
+        if type(physics_step) is not int or physics_step < 0:
+            raise ValueError("MEM physics_step must be a nonnegative integer")
+        if self._frames and physics_step <= self._frames[-1][0]:
+            raise ValueError("MEM observations must advance the measured physics clock")
+        if self._frames and physics_step - self._frames[-1][0] > 15:
+            raise ValueError(
+                "MEM dense history cannot skip a physical control observation"
+            )
+        reference = deepcopy(reference)
+        for key, value in {
+            "env_id": self.env_id,
+            "episode_id": self.episode_id,
+            "physics_step": physics_step,
+        }.items():
+            if reference.get(key, value) != value:
+                raise ValueError(
+                    "MEM reference owner or physics timestamp disagrees with its observation"
+                )
+            reference[key] = value
+        if "mem_history" in reference:
+            raise ValueError(
+                "MEM history frame references must not nest another window"
+            )
+        native = {}
+        for name in CAMERAS:
+            value = np.asarray(observation[name])
+            if value.shape != (480, 640, 3) or value.dtype != np.uint8:
+                raise ValueError(f"Expected native RGB8 {name}[480,640,3]")
+            native[name] = value.copy()
+        state = np.asarray(observation["state"], dtype=np.float32)
+        if state.shape != (24,) or not np.isfinite(state).all():
+            raise ValueError("MEM requires measured finite SDK24 state")
+        native["state"] = state.copy()
+        native["instruction"] = observation.get("instruction", "")
+        self._frames.append((physics_step, native, deepcopy(reference)))
+
+    def window(self, *, references: bool = False) -> dict:
+        """Return oldest-to-current samples, masking unavailable observations."""
+        if not self._frames:
+            raise ValueError("MEM history must contain the current observation")
+        current = self._frames[-1][0]
+        frames, valid, ticks, ages = [], [], [], []
+        for offset in range(self.num_frames - 1, -1, -1):
+            target = current - offset * self.stride_ticks
+            candidates = [item for item in self._frames if item[0] <= target]
+            item = candidates[-1] if candidates else self._frames[0]
+            present = bool(candidates)
+            frames.append(deepcopy(item[2]) if references else item[1])
+            valid.append(present)
+            ticks.append(item[0] if present else None)
+            ages.append((current - item[0]) * self.physics_dt_s if present else 0.0)
+        return {
+            "version": HISTORY_VERSION,
+            "env_id": self.env_id,
+            "episode_id": self.episode_id,
+            "current_physics_step": current,
+            "frames": frames,
+            "valid_mask": valid,
+            "physics_steps": ticks,
+            "age_s": ages,
+        }
+
+
+def validate_history_reference(
+    history: dict, *, current_physics_step: int, persisted: bool = False
+) -> None:
+    """Reject future, reordered, cross-episode or inconsistent history metadata."""
+    fields = ("frames", "valid_mask", "physics_steps", "age_s")
+    if not history.get("env_id") or not history.get("episode_id"):
+        raise ValueError("MEM references require environment and episode identity")
+    if history.get("version") != HISTORY_VERSION:
+        raise ValueError("Unsupported MEM history version")
+    if history.get("current_physics_step") != current_physics_step:
+        raise ValueError("MEM history current timestamp differs from its observation")
+    lengths = [len(history.get(key, [])) for key in fields]
+    if not lengths[0] or len(set(lengths)) != 1:
+        raise ValueError("MEM frame, mask, timestamp and age lengths must match")
+    previous = -1
+    for frame, valid, tick, age in zip(*(history[key] for key in fields)):
+        if type(valid) is not bool or not isinstance(frame, dict):
+            raise ValueError("MEM frames require dicts and explicit boolean validity")
+        if not np.isfinite(age) or age < 0:
+            raise ValueError("MEM ages must be finite and nonnegative")
+        if persisted:
+            allowed = {
+                "npz_path",
+                "instruction",
+                "env_id",
+                "episode_id",
+                "physics_step",
+            }
+            if (
+                set(frame) - allowed
+                or not isinstance(frame.get("npz_path"), str)
+                or not frame["npz_path"].strip()
+            ):
+                raise ValueError(
+                    "Persisted MEM frames require safe NPZ references, never inline observations"
+                )
+            if (frame.get("env_id"), frame.get("episode_id")) != (
+                history["env_id"],
+                history["episode_id"],
+            ):
+                raise ValueError(
+                    "MEM frame reference belongs to another environment/episode"
+                )
+            reference_tick = frame.get("physics_step")
+            if (
+                type(reference_tick) is not int
+                or not 0 <= reference_tick <= current_physics_step
+            ):
+                raise ValueError(
+                    "MEM frame reference contains a future or missing physics timestamp"
+                )
+            if valid and reference_tick != tick:
+                raise ValueError(
+                    "MEM frame reference physics timestamp disagrees with its history slot"
+                )
+            if "instruction" in frame and not isinstance(frame["instruction"], str):
+                raise ValueError("MEM frame instruction must be text")
+        if not valid:
+            if tick is not None:
+                raise ValueError(
+                    "Invalid MEM history must not claim an observation time"
+                )
+            continue
+        if type(tick) is not int or not previous < tick <= current_physics_step:
+            raise ValueError("MEM history is not causal and chronological")
+        if not np.isclose(age, (current_physics_step - tick) * 0.004):
+            raise ValueError("MEM frame age differs from the measured physics time")
+        previous = tick
+    if (
+        not history["valid_mask"][-1]
+        or history["physics_steps"][-1] != current_physics_step
+    ):
+        raise ValueError("The final MEM frame must be the actual current observation")
