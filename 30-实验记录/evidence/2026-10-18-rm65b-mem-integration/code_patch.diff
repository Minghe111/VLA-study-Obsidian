+class PackedAttentionLoRA(nn.Module):
+    """LoRA for packed QKV and output weights, without renaming base weights."""
+
+    def __init__(
+        self, width: int, rank: int, alpha: float, reference: torch.Tensor
+    ) -> None:
+        super().__init__()
+        if rank <= 0 or alpha <= 0:
+            raise ValueError("Visual LoRA rank and alpha must be positive")
+        options = {"device": reference.device, "dtype": reference.dtype}
+        self.qkv_lora_A = nn.Parameter(torch.empty(rank, width, **options))
+        self.qkv_lora_B = nn.Parameter(torch.zeros(3 * width, rank, **options))
+        self.out_lora_A = nn.Parameter(torch.empty(rank, width, **options))
+        self.out_lora_B = nn.Parameter(torch.zeros(width, rank, **options))
+        nn.init.kaiming_uniform_(self.qkv_lora_A, a=math.sqrt(5))
+        nn.init.kaiming_uniform_(self.out_lora_A, a=math.sqrt(5))
+        self.register_buffer("lora_scaling", reference.new_tensor(float(alpha) / rank))
+        self.enabled = True
+
+    def weights(
+        self, attention: nn.MultiheadAttention
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Return effective weights for both functional and video attention."""
+        qkv = attention.in_proj_weight
+        out = attention.out_proj.weight
+        if self.enabled:
+            qkv = qkv + (self.qkv_lora_B @ self.qkv_lora_A).to(
+                qkv.dtype
+            ) * self.lora_scaling.to(qkv.dtype)
+            out = out + (self.out_lora_B @ self.out_lora_A).to(
+                out.dtype
+            ) * self.lora_scaling.to(out.dtype)
+        return qkv, out
+
+    def is_noop(self) -> bool:
+        """Allow the exact original inference path at zero initialization."""
+        return not self.enabled or (
+            not torch.is_grad_enabled()
+            and not torch.count_nonzero(self.qkv_lora_B).item()
+            and not torch.count_nonzero(self.out_lora_B).item()
+        )
+
+
+def temporal_position(age_s: torch.Tensor, width: int) -> torch.Tensor:
+    """Fixed relative-time embedding with exactly zero encoding at age zero."""
+    if width % 2:
+        raise ValueError(f"Temporal embedding width must be even, found {width}")
+    frequency = torch.exp(
+        -math.log(10000.0)
+        * torch.arange(width // 2, device=age_s.device, dtype=torch.float32)
+        / max(width // 2 - 1, 1)
+    )
+    phase = -age_s.float()[..., None] * frequency
+    return torch.cat([torch.sin(phase), torch.cos(phase) - 1.0], dim=-1)
+
+
+def effective_weights(block: nn.Module) -> tuple[torch.Tensor, torch.Tensor]:
+    """Read the original packed QKV/out weights with optional visual LoRA."""
+    adapter = getattr(block, "mem_lora", None)
+    if adapter is not None:
+        return adapter.weights(block.attn)
+    return block.attn.in_proj_weight, block.attn.out_proj.weight
+
+
+def lora_image_attention(block: nn.Module, normalized: torch.Tensor) -> torch.Tensor:
+    """Run MHA with effective output weights; ``out_proj.forward`` is not used."""
+    attention = block.attn
+    qkv, out = effective_weights(block)
+    transposed = normalized.transpose(0, 1)
+    result, _ = F.multi_head_attention_forward(
+        transposed,
+        transposed,
+        transposed,
+        attention.embed_dim,
+        attention.num_heads,
+        qkv,
+        attention.in_proj_bias,
+        attention.bias_k,
+        attention.bias_v,
+        attention.add_zero_attn,
+        attention.dropout,
+        out,
+        attention.out_proj.bias,
+        training=attention.training,
+        need_weights=True,
+    )
+    return result.transpose(0, 1)
+
+
+def video_block(
+    block: nn.Module,
+    tokens: torch.Tensor,
+    valid_mask: torch.Tensor,
+    age_s: torch.Tensor,
+) -> torch.Tensor:
+    """Apply one shared-projection temporal/spatial block to ``[B,T,P,D]``."""
+    batch, frames, patches, width = tokens.shape
+    heads = block.attn.num_heads
+    head_width = width // heads
+    norm_dtype = block.norm1.weight.dtype
+    encoded = tokens + temporal_position(age_s, width)[:, :, None].to(tokens.dtype)
+    normalized = block.norm1(encoded.to(norm_dtype))
+    qkv_weight, out_weight = effective_weights(block)
+    projected = F.linear(
+        normalized.to(qkv_weight.dtype), qkv_weight, block.attn.in_proj_bias
+    ).reshape(batch, frames, patches, 3, heads, head_width)
+    query, key, value = projected.unbind(dim=3)
