+@pytest.fixture
+def video_encoder():
+    torch.set_num_threads(2)
+    torch.manual_seed(103)
+    model = SigLIPViT(variant="mu/32")
+    model.configure_mem(
+        {"num_frames": 4, "temporal_interval": 1, "drop_after": 1, "lora_rank": 2}
+    )
+    return model
+
+
+def video_input():
+    images = torch.rand(1, 4, 224, 224, 3) * 2 - 1
+    valid = torch.ones(1, 4, dtype=torch.bool)
+    age = torch.tensor([[1.44, 0.96, 0.48, 0.0]])
+    return images, valid, age
+
+
+def test_single_frame_bypasses_video_exactly_and_preserves_base_keys():
+    torch.manual_seed(11)
+    model = SigLIPViT(variant="mu/32").eval()
+    base_keys = set(model.state_dict())
+    image = torch.randn(1, 224, 224, 3)
+    with torch.no_grad():
+        original, _ = model(image)
+    model.configure_mem({"temporal_interval": 1, "drop_after": 1, "lora_rank": 2})
+    assert base_keys <= set(model.state_dict())
+    assert set(model.state_dict()) - base_keys == set(model.mem_adapter_keys())
+    with torch.no_grad():
+        adapted, _ = model.forward_video(
+            image[:, None], torch.ones(1, 1, dtype=torch.bool), torch.zeros(1, 1)
+        )
+    torch.testing.assert_close(adapted, original, rtol=0, atol=0)
+
+
+def test_disabled_video_and_adapter_recover_original(video_encoder):
+    model = video_encoder.eval()
+    images, valid, age = video_input()
+    with torch.no_grad():
+        baseline, _ = model(images[:, -1])
+        for block in model.encoder.layers:
+            block.mem_lora.out_lora_B.normal_(std=0.1)
+        model.set_mem_adapter_enabled(False)
+        model.mem_enabled = False
+        recovered, _ = model.forward_video(images, valid, age)
+    torch.testing.assert_close(recovered, baseline, rtol=0, atol=0)
+
+
+def test_invalid_history_cannot_change_current_output(video_encoder):
+    images, valid, age = video_input()
+    valid[:, :2] = False
+    with torch.no_grad():
+        output, _ = video_encoder.forward_video(images, valid, age)
+        images[:, :2] = float("nan")
+        age[:, :2] = float("nan")
+        changed, _ = video_encoder.forward_video(images, valid, age)
+    assert output.shape == (1, 49, 32)
+    assert torch.isfinite(changed).all()
+    torch.testing.assert_close(output, changed, rtol=0, atol=0)
+
+
+def test_only_current_valid_frame_matches_single_image(video_encoder):
+    images, valid, age = video_input()
+    valid[:, :-1] = False
+    with torch.no_grad():
+        video, _ = video_encoder.forward_video(images, valid, age)
+        single, _ = video_encoder(images[:, -1])
+    torch.testing.assert_close(video, single, rtol=1e-5, atol=1e-6)
+
+
+def test_temporal_attention_is_causal():
+    torch.manual_seed(7)
+    block = Encoder1DBlock(32, 2).eval()
+    tokens = torch.randn(1, 4, 3, 32)
+    valid = torch.ones(1, 4, dtype=torch.bool)
+    age = torch.tensor([[1.44, 0.96, 0.48, 0.0]])
+    with torch.no_grad():
+        output = video_block(block, tokens, valid, age)
+        tokens[:, -1] = torch.randn_like(tokens[:, -1]) * 100
+        changed = video_block(block, tokens, valid, age)
+    torch.testing.assert_close(output[:, :-1], changed[:, :-1], rtol=0, atol=0)
+    assert not torch.allclose(output[:, -1], changed[:, -1])
+
+
+def test_current_representation_uses_valid_history(video_encoder):
+    images, valid, age = video_input()
+    with torch.no_grad():
+        output, _ = video_encoder.forward_video(images, valid, age)
+        images[:, 0] = -images[:, 0]
+        changed, _ = video_encoder.forward_video(images, valid, age)
+    assert (output - changed).abs().max() > 1e-4
+
+
+def test_temporal_encoding_zero_boundary_and_elapsed_time():
+    encoded = temporal_position(torch.tensor([[1.44, 0.48, 0.0]]), 32)
+    assert torch.count_nonzero(encoded[:, -1]) == 0
+    assert not torch.equal(encoded[:, 0], encoded[:, 1])
+
+
+def test_visual_lora_reaches_qkv_and_functional_out_projection(video_encoder):
+    model = video_encoder
+    for parameter in model.parameters():
+        parameter.requires_grad_(False)
+    for parameter in model.mem_adapter_parameters():
+        parameter.requires_grad_(True)
+    images, valid, age = video_input()
+    output, _ = model.forward_video(images, valid, age)
+    (output * torch.randn_like(output)).sum().backward()
+    adapter = model.encoder.layers[0].mem_lora
+    assert adapter.qkv_lora_B.grad.abs().sum() > 0
+    assert adapter.out_lora_B.grad.abs().sum() > 0
+    assert model.encoder.layers[0].attn.in_proj_weight.grad is None
+    assert model.encoder.layers[0].attn.out_proj.weight.grad is None
+    with torch.no_grad():
+        before, _ = model(images[:, -1])
+        adapter.out_lora_B.normal_(std=0.1)
+        after, _ = model(images[:, -1])
+    assert not torch.allclose(before, after)
+
+
+def test_checkpointed_video_backward_and_checkpoint_roundtrip(video_encoder):
+    model = video_encoder.train()
+    model.encoder.gradient_checkpointing = True
+    for parameter in model.parameters():
+        parameter.requires_grad_(False)
+    for parameter in model.mem_adapter_parameters():
+        parameter.requires_grad_(True)
+    images, valid, age = video_input()
+    output, _ = model.forward_video(images, valid, age)
+    (output * torch.randn_like(output)).sum().backward()
+    assert any(
+        p.grad is not None and p.grad.abs().sum() > 0
+        for p in model.mem_adapter_parameters()
+    )
+    with torch.no_grad():
+        model.encoder.layers[0].mem_lora.qkv_lora_B.normal_(std=0.01)
+        expected, _ = model.forward_video(images, valid, age)
+    storage = io.BytesIO()
+    torch.save(model.state_dict(), storage)
+    storage.seek(0)
+    restored = SigLIPViT(variant="mu/32")
+    restored.configure_mem(
+        {"num_frames": 4, "temporal_interval": 1, "drop_after": 1, "lora_rank": 2}
+    )
+    restored.load_state_dict(torch.load(storage, weights_only=True), strict=True)
+    with torch.no_grad():
+        actual, _ = restored.forward_video(images, valid, age)
+    torch.testing.assert_close(expected, actual, rtol=0, atol=0)
+
+
+def test_strict_reload_restores_scaling_when_constructor_alpha_differs(video_encoder):
+    model = video_encoder.eval()
+    images, valid, age = video_input()
+    with torch.no_grad():
+        model.encoder.layers[0].mem_lora.qkv_lora_B.normal_(std=0.1)
+        model.encoder.layers[0].mem_lora.out_lora_B.normal_(std=0.1)
+        expected, _ = model.forward_video(images, valid, age)
+    restored = SigLIPViT(variant="mu/32").eval()
+    restored.configure_mem(
+        {
+            "num_frames": 4,
+            "temporal_interval": 1,
+            "drop_after": 1,
+            "lora_rank": 2,
+            "lora_alpha": 20.0,
+        }
+    )
+    assert restored.encoder.layers[0].mem_lora.lora_scaling.item() == 10.0
+    restored.load_state_dict(model.state_dict(), strict=True)
+    assert restored.encoder.layers[0].mem_lora.lora_scaling.item() == 1.0
+    with torch.no_grad():
+        actual, _ = restored.forward_video(images, valid, age)
+    torch.testing.assert_close(expected, actual, rtol=0, atol=0)
+
+
+def test_six_real_width_adapters_match_planned_parameter_count():
+    reference = torch.empty(0)
+    adapters = [PackedAttentionLoRA(1152, 8, 8, reference) for _ in range(6)]
+    assert (
