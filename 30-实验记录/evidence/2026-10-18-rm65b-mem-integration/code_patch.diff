+"""Capture actual SAPIEN RGB/state history using diagnostic hold controls only."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import time
+import traceback
+from pathlib import Path
+from typing import ClassVar
+
+import numpy as np
+import yaml
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output = args.output.resolve()
+    args.output.mkdir(parents=True, exist_ok=False)
+    from integrations.realman_rm65b_gen4.rl_env import RealManVectorEnv
+    from rlinf.data.datasets.recap.hierarchical_dataset import validate_memory_trace
+    from rlinf.data.schema.hierarchical_types import load_episode_json
+    from rlinf.workers.rollout.hf.hierarchical_recap_worker import (
+        GeneratedText,
+        HierarchicalReCapRolloutWorker,
+    )
+
+    config = yaml.safe_load(args.config.read_text())
+    task = dict(config["environment"]["task_config"])
+    task.update(
+        runtime_dir=str(args.output / "runtime"),
+        max_episode_steps=26,
+        rpc_timeout_s=150.0,
+    )
+    source = (
+        Path(task["asset_root"])
+        / "embodiments/realman-rm65b-inspire-gen4/robot_sapien.urdf"
+    )
+    original_hash = hashlib.sha256(source.read_bytes()).hexdigest()
+    report = {
+        "scope": "actual_simulator_history_capture",
+        "policy_loaded": False,
+        "high_text_source": "authored_diagnostic_fixture",
+        "motor_source": "measured_state_hold_not_vla",
+        "training": False,
+        "optimizer_steps": 0,
+        "excluded_from_training": True,
+        "policy_success_claimed": False,
+    }
+    env = None
+    started = time.monotonic()
+
+    class DiagnosticHold:
+        version = "mem_diagnostic_hold_v1"
+        versions: ClassVar[dict[str, str]] = {"purpose": "excluded_functional_check"}
+
+        def generate(self, observation, mode, context):
+            responses = {
+                "READ": '{"read_ids":["current_progress"]}',
+                "WRITE": '{"operations":[{"op":"WRITE","slot_id":"current_progress","value":"Interface check; task completion not confirmed.","confirmed":false}]}',
+                "SUBTASK": "Hold the current position for an interface check.",
+            }
+            return GeneratedText(responses[mode], [1], True)
+
+        def actions(self, observation, context):
+            return np.repeat(
+                np.asarray(observation["state"], np.float32)[None], 16, axis=0
+            )
+
+    try:
+        env = RealManVectorEnv(task, n_envs=1, env_seeds=[9001])
+        worker = HierarchicalReCapRolloutWorker(
+            DiagnosticHold(),
+            env,
+            config["memory"]["catalogue"],
+            high_level_window=32,
+            max_steps=26,
+            history_num_frames=4,
+            history_stride_steps=8,
+            strict_memory_protocol=True,
+        )
+        worker.collect_episode(
+            args.output / "diagnostic_episode",
+            episode_id="mem_history_diagnostic_9001",
+            goal=config["rollout"]["goal"],
+            seed=9001,
+            evaluate=True,
+        )
+        path = args.output / "diagnostic_episode/episode.json"
+        episode = load_episode_json(path)
