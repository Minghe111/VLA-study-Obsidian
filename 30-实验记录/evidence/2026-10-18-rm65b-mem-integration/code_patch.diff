+    set_torch_compile(False)
+    return Pi0RecapHier(
+        Pi0Config(
+            pi05=True,
+            dtype="float32",
+            vision_variant="mu/224",
+            vocabulary_size=128,
+            paligemma_variant="dummy",
+            action_expert_variant="dummy",
+            action_horizon=2,
+            action_dim=4,
+            max_token_len=4,
+            mem_enabled=mem,
+            mem_temporal_interval=1,
+            mem_drop_after=1,
+        )
+    )
