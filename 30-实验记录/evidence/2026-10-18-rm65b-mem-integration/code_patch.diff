+        query.permute(0, 2, 3, 1, 4).reshape(time_shape),
+        key.permute(0, 2, 3, 1, 4).reshape(time_shape),
+        value.permute(0, 2, 3, 1, 4).reshape(time_shape),
+        attn_mask=allowed,
+        dropout_p=block.attn.dropout if block.training else 0.0,
+    ).reshape(batch, patches, heads, frames, head_width)
+    space_query = query.permute(0, 1, 3, 2, 4).reshape(
+        batch * frames, heads, patches, head_width
+    )
+    space_key = key.permute(0, 1, 3, 2, 4).reshape_as(space_query)
+    space_value = time_value.permute(0, 3, 2, 1, 4).reshape_as(space_query)
+    attended = F.scaled_dot_product_attention(
+        space_query,
+        space_key,
+        space_value,
+        dropout_p=block.attn.dropout if block.training else 0.0,
+    )
