+"""Parameter-sharing space/time attention for the RM65-B MEM adaptation.
+
+The operator uses ``A_space(Q, K) @ A_time(Q, K) @ V``, followed by the
+original output projection, residual and MLP. It interprets the composed
+attention in MEM Appendix C; it is not a claim of official-code parity.
+"""
+
+from __future__ import annotations
+
+import math
+
+import torch
+import torch.nn as nn
