+                "metrics": metrics,
+                "changed_tensors_by_group": changed,
+                "same_instance_compact_reload_exact": True,
+            }
+
+        run("one_functional_update_and_compact_reload", update_probe)
+        with torch.no_grad():
+            model.load_state_dict(original_extensions, strict=False)
+        assert all(
+            torch.equal(value, model.state_dict()[key].cpu())
+            for key, value in original_extensions.items()
