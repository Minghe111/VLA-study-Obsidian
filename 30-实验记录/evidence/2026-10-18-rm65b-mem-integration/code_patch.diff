+"""Reload the isolated probe adapter in a fresh process; audit full-history CE."""
+
+import argparse
+import dataclasses
+import json
+import resource
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from omegaconf import OmegaConf
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--episode", type=Path, required=True)
+    parser.add_argument("--adapter", type=Path, required=True)
+    parser.add_argument("--golden", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output = args.output.resolve()
+    args.output.mkdir(parents=True, exist_ok=False)
+    from rlinf.data.datasets.recap.hierarchical_dataset import load_observation
+    from rlinf.data.schema.hierarchical_types import load_episode_json
+    from rlinf.models.embodiment.openpi import get_model
+    from rlinf.models.embodiment.openpi.recap_tokenizer import (
+        RecapTokenizer,
+        build_action_prefix,
+        canonical_json,
+    )
+    from rlinf.workers.rollout.hf.hierarchical_recap_worker import NativePi05Actor
+
+    config = yaml.safe_load(args.config.read_text())
+    config["model"]["openpi"]["recap_training_stage"] = "joint"
+    config["model"]["openpi"]["recap_adapter_path"] = str(args.adapter.resolve())
+    torch.set_num_threads(4)
+    torch.manual_seed(20261018)
+    start = time.monotonic()
+    model = get_model(OmegaConf.create(config["model"])).to("cuda:0").eval()
+    tokenizer = RecapTokenizer.from_local_paths(
+        text_tokenizer_path=config["tokenizer"]["text_tokenizer_path"]
+    )
+    actor = NativePi05Actor(
+        model, tokenizer, version="excluded_probe_reload", advantage_condition=False
+    )
+    episode = load_episode_json(args.episode)
+    reference = episode.steps[-1].next_observation
+    native = load_observation(reference)
+    native["mem_history"] = reference["mem_history"]
+    full_base = actor._base_observation(native)
+    earlier = load_observation(episode.steps[8].observation)
+    earlier_base = model.env_obs_to_observation(actor.env_io(earlier, ""))
+    prompt = build_action_prefix(
+        task=config["rollout"]["goal"],
+        subtask="Hold the current position for an interface check.",
+        state=earlier_base.state[0].float().cpu().numpy(),
+        visible_memory=canonical_json(episode.decisions[0].actor_memory),
+        advantage=None,
+    )
+    ids = torch.as_tensor(
+        tokenizer.encode_prefix(prompt), device="cuda:0", dtype=torch.long
+    )[None]
+    observation = dataclasses.replace(
+        full_base,
+        tokenized_prompt=ids,
+        tokenized_prompt_mask=torch.ones_like(ids, dtype=torch.bool),
+    )
+    noise = torch.randn(
+        (1, 16, 32),
+        device="cuda:0",
+        generator=torch.Generator(device="cuda:0").manual_seed(20261018),
+    )
+    with torch.no_grad():
+        actual, _ = model._predict_eval(observation, noise=noise)
+    actual = actual.float().cpu().numpy()
+    expected = np.load(args.golden, allow_pickle=False)
+    difference = float(np.abs(actual - expected).max())
+    assert np.array_equal(actual, expected), difference
+    torch.cuda.reset_peak_memory_stats()
+    model.gradient_checkpointing_enable(
+        gradient_checkpointing_kwargs={"use_reentrant": False}
+    )
+    model.train()
+    targets = torch.as_tensor(
+        tokenizer.encode_target("Hold the current position for an interface check."),
+        device="cuda:0",
+        dtype=torch.long,
+    )[None]
+    loss = model.text_loss(
+        observation, targets, torch.ones_like(targets, dtype=torch.bool)
+    ).mean()
+    loss.backward()
+    groups = {}
+    params = dict(model.named_parameters())
+    for name, names in model.recap_parameter_groups.items():
+        if name == "frozen":
+            assert all(params[key].grad is None for key in names)
+            continue
+        groups[name] = sum(
+            int(params[key].grad is not None and params[key].grad.abs().sum() > 0)
+            for key in names
+        )
+    assert all(groups[key] > 0 for key in ("vision", "vlm", "history_state"))
+    assert groups["action_expert"] == 0
+    report = {
+        "passed": True,
+        "fresh_process_compact_reload_exact": True,
+        "max_abs_action_difference": difference,
+        "full_four_frame_valid": observation.history_valid_mask.cpu().tolist(),
+        "full_four_frame_ce": float(loss.detach()),
+        "nonzero_gradient_tensors": groups,
+        "peak_allocated_mib": torch.cuda.max_memory_allocated() / 2**20,
+        "peak_reserved_mib": torch.cuda.max_memory_reserved() / 2**20,
+        "host_peak_rss_mib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024,
+        "elapsed_s": time.monotonic() - start,
+        "optimizer_steps": 0,
+        "production_training_started": False,
+        "checkpoint_purpose": "excluded_functional_probe_only",
+    }
+    (args.output / "report.json").write_text(json.dumps(report, indent=2))
+    print(json.dumps(report), flush=True)
+
+
+if __name__ == "__main__":
+    main()
