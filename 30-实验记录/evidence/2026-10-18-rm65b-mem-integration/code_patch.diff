+                assert all(
+                    result[key]["nonzero_tensors"] > 0
+                    for key in ("vision", "history_state", "vlm")
+                )
+                assert result["action_expert"]["tensors"] == 0
+            else:
+                assert result["action_expert"]["nonzero_tensors"] > 0
+                assert all(
+                    result[key]["tensors"] == 0
+                    for key in ("vision", "history_state", "vlm")
+                )
+            del output
+            model.zero_grad(set_to_none=True)
+            gc.collect()
+            return {"loss": value, "gradients": result}
+
+        run("high_ce_backward", lambda: backward("high_ce"))
