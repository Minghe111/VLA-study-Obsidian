+def native(value=0):
+    return {
+        **{
+            key: np.full((480, 640, 3), value, np.uint8)
+            for key in ("full_image", "left_wrist_image", "right_wrist_image")
+        },
+        "state": np.arange(24, dtype=np.float32) + value,
+    }
+
+
+class TransformActor:
+    device = torch.device("cpu")
+    max_token_len = 256
+    mem_enabled = True
+
+    def __init__(self):
+        self.transformed_states = []
+
+    def input_transform(self, raw, transpose=False):
+        state = raw["observation/state"]
+        self.transformed_states.append(state.copy())
+        padded = np.pad(state / 100.0, ((0, 0), (0, 8)))
+        images = (
+            raw["observation/image"],
+            raw["observation/wrist_image"][:, 0],
+            raw["observation/wrist_image"][:, 1],
+        )
+        result = {
+            "image": {
+                key: torch.from_numpy(image[:, :6, :7].copy())
+                for key, image in zip(IMAGE_KEYS, images)
+            },
+            "image_mask": {key: torch.ones(1, dtype=torch.bool) for key in IMAGE_KEYS},
+            "state": torch.from_numpy(padded),
+        }
+        if "actions" in raw:
+            result["actions"] = torch.from_numpy(
+                np.pad(raw["actions"] / 100.0, ((0, 0), (0, 0), (0, 8)))
+            )
+        return result
+
+    def _observation_dict_to_device(self, processed):
+        return Observation.from_dict(processed)
+
+
+def transformed(actor, current):
+    return actor._observation_dict_to_device(
+        actor.input_transform(native_transform_input(current))
+    )
+
+
+def clip():
+    past, current = native(1), native(2)
+    current["mem_history"] = {
+        "frames": [None, None, past, dict(current)],
+        "valid_mask": [False, False, True, True],
+        "age_s": [1.44, 0.96, 0.48, 0.0],
+        "physics_steps": [None, None, 0, 120],
+    }
+    return current
+
+
+def test_history_reuses_normalization_padding_and_current_frame():
+    actor, raw = TransformActor(), clip()
+    current = transformed(actor, raw)
+    attached = attach_mem_history(actor, current, raw)
+    assert len(actor.transformed_states) == 2  # current + one actual past
+    assert attached.state_history.shape == (1, 4, 32)
+    torch.testing.assert_close(
+        attached.state_history[0, 2, :24], torch.arange(24) / 100 + 0.01
+    )
+    assert not attached.state_history[..., 24:].any()
+    assert attached.history_valid_mask.tolist() == [[False, False, True, True]]
+    prepared = preprocess_observation(attached, image_resolution=(8, 8))
+    for key in IMAGE_KEYS:
+        assert prepared.image_history[key].shape == (1, 4, 8, 8, 3)
+        torch.testing.assert_close(
+            prepared.image_history[key][:, -1], prepared.images[key]
+        )
+    restored = Observation.from_dict(attached.to_dict())
+    torch.testing.assert_close(restored.state_history, attached.state_history)
+
+
+@pytest.mark.parametrize("bad", ["future", "clock", "current", "valid"])
+def test_history_rejects_fabricated_or_future_frames(bad):
+    actor, raw = TransformActor(), clip()
+    if bad == "future":
+        raw["mem_history"]["age_s"][2] = -0.1
+    elif bad == "clock":
+        raw["mem_history"]["physics_steps"][2] = 15
+    elif bad == "current":
+        raw["mem_history"]["frames"][-1] = native(3)
+    else:
+        raw["mem_history"]["valid_mask"][-1] = False
+    with pytest.raises(ValueError):
+        attach_mem_history(actor, transformed(actor, raw), raw)
