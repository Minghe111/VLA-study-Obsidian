+def test_mem_rollout_records_causal_references_and_prewrite_context(tmp_path):
+    worker = HierarchicalReCapRolloutWorker(
+        ExternalPolicy(),
+        ExternalClockedEnvironment(),
+        {"location": "Observed initial location"},
+        high_level_window=2,
+        max_steps=3,
+        history_num_frames=4,
+        history_stride_steps=1,
+        strict_memory_protocol=True,
+    )
+    episode = worker.collect_episode(
+        tmp_path / "episode", episode_id="ep", goal="sample task", seed=1
+    )
+    restored = load_episode_json(tmp_path / "episode/episode.json")
+    assert restored.to_dict() == episode.to_dict()
+    assert restored.steps[-1].next_observation["mem_history"]["physics_steps"] == [
+        0,
+        15,
+        30,
+        45,
+    ]
+    validate_memory_trace(restored)
+    high = build_high_level_samples(restored, require_labels=False)
+    assert high[1]["context"]["selected_memory"][0]["status"] == "empty"
+    assert (
+        high[2]["context"]["actor_memory"]["selected"][0]["value"]
+        == "initial left side"
+    )
+    assert restored.steps[0].physics_dt == 0.06
+    forged = deepcopy(restored)
+    frame = forged.steps[0].observation["mem_history"]["frames"][-1]
+    frame["npz_path"] = restored.steps[0].next_observation["npz_path"]
+    with pytest.raises(ValueError, match="timestamp"):
+        forged.validate()
