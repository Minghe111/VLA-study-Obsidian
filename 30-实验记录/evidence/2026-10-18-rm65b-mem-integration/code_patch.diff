+            )
+            assert all(
+                p._version == base_versions[name]
+                for name, p in model.named_parameters()
+                if name in base_versions
+            )
+            torch.save(current, args.output / "probe_only_adapters.pt")
+            torch.save(
+                {
+                    "optimizer": optimizer.state_dict(),
+                    "global_step": worker.global_step,
+                    "training_manifest": recap_training_manifest(model),
+                },
+                args.output / "probe_only_trainer_state.pt",
+            )
+            (args.output / "probe_only_manifest.json").write_text(
+                json.dumps(
+                    {
+                        "purpose": "functional_update_only_excluded_from_training",
+                        "base_checkpoint": cfg["model"]["model_path"],
+                        "training_manifest": recap_training_manifest(model),
+                    },
+                    indent=2,
+                )
+            )
+            model.eval()
+            with torch.no_grad():
+                expected, _ = model._predict_eval(full_action_obs, noise=noise())
