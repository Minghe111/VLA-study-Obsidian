+"""Causal raw-video attachment through the original SDK24 transform pipeline.
+
+The transport remains native RGB8/state24. No raw SDK units enter the learned
+state projection: every history frame follows exactly the current-frame input
+transforms, including existing normalization and padding to the model dimension.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from collections.abc import Callable
+from typing import Any
+
+import numpy as np
+import torch
+
+from rlinf.models.embodiment.openpi.modules.model import Observation
+
+CAMERA_KEYS = ("full_image", "left_wrist_image", "right_wrist_image")
+
+
+def native_transform_input(native: dict[str, Any], actions: Any = None) -> dict:
+    """Repack one raw RM65-B observation, preserving its physical units."""
+    raw = {
+        "observation/image": np.asarray(native["full_image"])[None],
+        "observation/wrist_image": np.stack(
+            [native["left_wrist_image"], native["right_wrist_image"]]
+        )[None],
+        "observation/state": np.asarray(native["state"], dtype=np.float32)[None],
+        "prompt": [""],
+    }
+    if actions is not None:
+        raw["actions"] = np.asarray(actions, dtype=np.float32)[None]
+    return raw
+
+
+def attach_mem_history(
+    actor: Any,
+    observation: Observation,
+    native_or_reference: dict[str, Any],
+    *,
+    load_reference: Callable[[dict], dict] | None = None,
+) -> Observation:
+    """Attach ``mem_history`` to a transformed single-example observation.
+
+    ``frames`` are oldest-to-current raw native observations or NPZ references.
+    Invalid slots may contain ``None``; they are masked and never represented as
+    observed past data. Actual ages and physics steps are validated causally.
+    """
+    history = native_or_reference.get("mem_history")
+    if history is None:
+        return observation
+    if observation.state.shape[0] != 1:
+        raise ValueError("Raw MEM attachment expects one episode observation at a time")
+    if load_reference is None:
+        from rlinf.data.datasets.recap.hierarchical_dataset import load_observation
+
+        load_reference = load_observation
+    frames = history.get("frames")
+    valid = history.get("valid_mask")
+    ages = history.get("age_s")
+    steps = history.get("physics_steps")
+    if not isinstance(frames, list) or not frames:
+        raise ValueError("MEM history requires a nonempty frame list")
+    count = len(frames)
+    if any(
+        not isinstance(values, list) or len(values) != count
+        for values in (valid, ages, steps)
+    ):
+        raise ValueError("MEM frames, masks, ages and physics steps must align")
+    if any(not isinstance(value, bool) for value in valid) or not valid[-1]:
+        raise ValueError("MEM validity must be boolean and current frame must be valid")
+    age_array = np.asarray(ages, dtype=np.float64)
+    if (
+        not np.isfinite(age_array).all()
+        or (age_array < 0).any()
+        or np.any(np.diff(age_array[np.asarray(valid)]) > 1e-7)
+    ):
+        raise ValueError("MEM ages must be finite, nonnegative and oldest-to-current")
+    if abs(age_array[-1]) > 1e-7:
+        raise ValueError("The current MEM frame must have age zero")
+    current_step = steps[-1]
+    if (
+        isinstance(current_step, bool)
+        or not isinstance(current_step, int)
+        or current_step < 0
+    ):
+        raise ValueError("Current MEM physics step must be a nonnegative integer")
+    if history.get("current_physics_step", current_step) != current_step:
+        raise ValueError("MEM current physics step disagrees with its final frame")
+    prior_step = -1
+    for index, (is_valid, step) in enumerate(zip(valid, steps)):
+        if not is_valid:
+            continue
+        if (
+            isinstance(step, bool)
+            or not isinstance(step, int)
+            or not prior_step < step <= current_step
+        ):
+            raise ValueError(
+                "Valid MEM physics steps must strictly increase without future data"
+            )
+        if abs(age_array[index] - (current_step - step) * 0.004) > 1e-6:
+            raise ValueError("MEM age must match the recorded 4ms physics clock")
+        prior_step = step
+    current = load_reference(native_or_reference)
+    last = load_reference(frames[-1])
+    if any(
+        not np.array_equal(np.asarray(current[key]), np.asarray(last[key]))
+        for key in (*CAMERA_KEYS, "state")
+    ):
+        raise ValueError("MEM final frame must equal the actual current observation")
+
+    normalized: list[Observation] = []
+    for index, frame in enumerate(frames):
+        if index == count - 1:
+            prepared = observation
+        elif valid[index]:
+            if frame is None:
+                raise ValueError("A valid MEM slot cannot contain a missing frame")
+            native = load_reference(frame)
+            transformed = actor.input_transform(
+                native_transform_input(native), transpose=False
+            )
+            prepared = actor._observation_dict_to_device(transformed)
+        else:
+            prepared = observation  # excluded by all temporal/state masks
+        if (
+            prepared.state.shape != observation.state.shape
+            or not torch.isfinite(prepared.state).all()
+        ):
+            raise ValueError(
+                "MEM states must use the finite normalized current-state shape"
+            )
+        normalized.append(prepared)
+    valid_tensor = torch.as_tensor(
+        valid, device=observation.state.device, dtype=torch.bool
+    )[None]
+    return dataclasses.replace(
+        observation,
+        image_history={
+            key: torch.stack([frame.images[key] for frame in normalized], dim=1)
+            for key in observation.images
+        },
+        history_masks={
+            key: torch.stack(
+                [frame.image_masks[key] for frame in normalized], dim=1
+            ).bool()
+            & valid_tensor
+            for key in observation.images
+        },
+        state_history=torch.stack([frame.state for frame in normalized], dim=1),
+        history_age_s=torch.as_tensor(
+            age_array, device=observation.state.device, dtype=torch.float32
+        )[None],
+        history_valid_mask=valid_tensor,
+    )
