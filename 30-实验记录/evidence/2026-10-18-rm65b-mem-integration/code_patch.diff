+        run("four_frame_forward", video_forward)
+
+        def generation():
+            result = {}
+            for mode in ("READ", "WRITE", "SUBTASK"):
+                context = {
+                    "goal": cfg["rollout"]["goal"],
+                    "memory_index": [
+                        {"slot_id": key, "description": value}
+                        for key, value in cfg["memory"]["catalogue"].items()
+                    ],
+                    "visible_memory": actor_memory if mode != "READ" else {},
+                    "history": "",
+                }
+                generated = actor.generate(full_native, mode, context)
+                result[mode] = {
+                    "text": generated.text,
+                    "ended_with_eos": generated.ended_with_eos,
+                    "tokens": len(generated.token_ids),
+                }
+            return result
+
+        run("untrained_high_generation_capability", generation)
+
+        high_text = build_high_prefix(
+            mode="SUBTASK",
+            task=cfg["rollout"]["goal"],
+            state=probe_base.state[0].float().cpu().numpy(),
+            visible_memory=canonical_json(actor_memory),
+            memory_index=canonical_json(cfg["memory"]["catalogue"]),
+            history="",
+            advantage=None,
+        )
+        high_obs = prompt_observation(probe_base, high_text)
+        high_ids = torch.as_tensor(
+            tokenizer.encode_target(
+                "Hold the current position for an interface check."
+            ),
+            device="cuda:0",
+            dtype=torch.long,
+        )[None]
+        executed = np.asarray(
+            [step.executed_action for step in episode.steps[8:24]], np.float32
+        )
+        assert executed.shape == (16, 24)
+        transformed = model.input_transform(
+            native_transform_input(
+                load_observation(episode.steps[8].observation), executed
+            ),
+            transpose=False,
+        )
+        actions = torch.as_tensor(
+            transformed["actions"], device="cuda:0", dtype=torch.float32
+        )
+        fast_ids = torch.as_tensor(
+            tokenizer.encode_fast(actions[0].cpu().numpy()),
+            device="cuda:0",
+            dtype=torch.long,
+        )[None]
+        valid_actions = torch.zeros_like(actions, dtype=torch.bool)
+        valid_actions[..., :24] = True
+        batch = {
+            "high_observation": high_obs,
+            "high_target_ids": high_ids,
+            "high_loss_mask": torch.ones_like(high_ids, dtype=torch.bool),
+            "fast_observation": action_obs,
+            "fast_target_ids": fast_ids,
+            "fast_loss_mask": torch.ones_like(fast_ids, dtype=torch.bool),
+            "action_observation": action_obs,
+            "actions": actions,
+            "action_valid_mask": valid_actions,
