+def test_mem_stages_freeze_every_base_and_preserve_state_layout():
+    model = actor(mem=True)
+    layouts = []
+    for stage in ("protocol", "video", "joint"):
+        groups = configure_recap_parameters(
+            model, training_stage=stage, rank=2, expert_rank=2
+        )
+        parameters = dict(model.named_parameters())
+        assert all(
+            parameters[name].requires_grad
+            for key, names in groups.items()
+            if key != "frozen"
+            for name in names
+        )
+        assert all(not parameters[name].requires_grad for name in groups["frozen"])
+        assert all(
+            is_adapter_key(name) or name.startswith("history_state_proj.")
+            for name, p in parameters.items()
+            if p.requires_grad
+        )
+        assert bool(groups["action_expert"]) == (stage == "joint")
+        assert bool(groups["vision"]) == (stage != "protocol")
+        assert model.mem_enabled == (stage != "protocol")
+        layouts.append(set(model.state_dict()))
+    assert layouts[0] == layouts[1] == layouts[2]
