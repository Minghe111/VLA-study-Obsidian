+def test_new_stage_adam_parameters_stay_fp32_and_legacy_dtype_is_unchanged():
+    model = actor(mem=True)
+    configure_recap_parameters(model, training_stage="joint", rank=2, expert_rank=2)
+    with torch.no_grad():
+        for name, value in (*model.named_parameters(), *model.named_buffers()):
+            if is_recap_extension_key(name):
+                value.fill_(0.1234567)
+    original_extensions = {
+        name: value.detach().clone()
+        for name, value in (*model.named_parameters(), *model.named_buffers())
+        if is_recap_extension_key(name)
+    }
+    _apply_openpi_param_dtypes(model, torch.bfloat16)
+    current = dict((*model.named_parameters(), *model.named_buffers()))
+    assert all(
+        torch.equal(current[name], expected)
+        for name, expected in original_extensions.items()
+    )
+    extension_parameters = [
+        parameter
+        for name, parameter in model.named_parameters()
+        if is_recap_extension_key(name)
+    ]
+    assert extension_parameters and all(
+        parameter.dtype == torch.float32 for parameter in extension_parameters
+    )
+    assert model.llm.layers[0].attn.q_proj[0].weight.dtype == torch.bfloat16
+    projection = model.llm.layers[0].attn.q_proj[0]
+    output = projection(torch.ones(1, projection.in_features, dtype=torch.bfloat16))
+    assert output.dtype == torch.bfloat16
+    output.float().sum().backward()
+    assert projection.lora_B.grad.dtype == torch.float32
+    optimizer = torch.optim.AdamW(
+        [parameter for parameter in model.parameters() if parameter.requires_grad],
+        lr=1e-3,
+    )
+    optimizer.step()
+    assert optimizer.state[projection.lora_B]["exp_avg"].dtype == torch.float32
+
+    legacy = actor()
+    configure_recap_parameters(legacy, rank=2)
+    _apply_openpi_param_dtypes(legacy, torch.bfloat16)
+    assert legacy.llm.layers[0].attn.q_proj[0].lora_A.dtype == torch.bfloat16
