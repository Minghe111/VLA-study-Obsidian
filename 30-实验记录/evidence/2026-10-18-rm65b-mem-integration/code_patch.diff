+import numpy as np
+import pytest
+import torch
+
+from rlinf.data.datasets.recap.hierarchical_collator import NativeJointCollator
+from rlinf.models.embodiment.openpi.mem_observation import (
+    attach_mem_history,
+    native_transform_input,
+)
