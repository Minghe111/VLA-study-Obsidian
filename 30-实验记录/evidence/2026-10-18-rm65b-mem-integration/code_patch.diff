+    def _validate_mem_history(self) -> None:
+        from rlinf.data.storage.observation_history import validate_history_reference
+
+        observations = []
+        tick = 0
+        for step in self.steps:
+            observations.append((step.observation, tick))
+            tick += step.physics_steps
+            observations.append((step.next_observation, tick))
+        if not any("mem_history" in reference for reference, _ in observations):
+            return
+        known_paths = {}
+        for reference, tick in observations:
+            if (
+                not isinstance(reference.get("npz_path"), str)
+                or not reference["npz_path"].strip()
+            ):
+                raise ValueError(
+                    "Persisted MEM observations require an actual NPZ reference"
+                )
+            if (
+                reference.get("env_id"),
+                reference.get("episode_id"),
+                reference.get("physics_step"),
+            ) != (self.env_id, self.episode_id, tick):
+                raise ValueError(
+                    "MEM observation owner or physics timestamp disagrees with the episode"
+                )
+            path = reference["npz_path"]
+            if path in known_paths and known_paths[path] != tick:
+                raise ValueError(
+                    "MEM NPZ path was reused for inconsistent physics timestamps"
+                )
+            known_paths[path] = tick
+        for reference, tick in observations:
+            history = reference.get("mem_history")
+            if history is None:
+                continue
+            if (history.get("env_id"), history.get("episode_id")) != (
+                self.env_id,
+                self.episode_id,
+            ):
+                raise ValueError("MEM history belongs to another environment/episode")
+            validate_history_reference(
+                history, current_physics_step=tick, persisted=True
+            )
+            for frame in history["frames"]:
+                if frame["npz_path"] not in known_paths:
+                    raise ValueError(
+                        "MEM frame reference does not belong to this episode"
+                    )
+                if known_paths[frame["npz_path"]] != frame["physics_step"]:
+                    raise ValueError(
+                        "MEM frame timestamp differs from its actual episode record"
+                    )
+            if history["frames"][-1]["npz_path"] != reference["npz_path"]:
+                raise ValueError(
+                    "MEM final frame must reference the actual current observation"
+                )
 
