+def test_npz_references_keep_history_sidecar(tmp_path):
+    actor, raw = TransformActor(), clip()
+    current_path, past_path = tmp_path / "current.npz", tmp_path / "past.npz"
+    np.savez(
+        current_path,
+        **{key: value for key, value in raw.items() if key != "mem_history"},
+    )
+    np.savez(past_path, **native(1))
+    raw["mem_history"]["frames"][-1] = {"npz_path": str(current_path)}
+    raw["mem_history"]["frames"][2] = {"npz_path": str(past_path)}
+    reference = {"npz_path": str(current_path), "mem_history": raw["mem_history"]}
+    attached = attach_mem_history(actor, transformed(actor, raw), reference)
+    assert attached.state_history.shape == (1, 4, 32)
