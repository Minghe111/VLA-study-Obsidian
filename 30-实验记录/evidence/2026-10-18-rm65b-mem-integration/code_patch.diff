@@ -0,0 +1,549 @@
+"""Real SFT/MEM forward, gradient and rolled-back functional-update probes."""
+
+from __future__ import annotations
+
+import argparse
+import dataclasses
+import gc
+import json
+import re
+import resource
+import subprocess
+import time
+import traceback
+from pathlib import Path
+
+import numpy as np
+import torch
+import yaml
+from omegaconf import OmegaConf
+
+
+def memory():
+    torch.cuda.synchronize()
+    used = subprocess.check_output(
+        ["nvidia-smi", "--query-gpu=memory.used", "--format=csv,noheader,nounits"],
+        text=True,
+    )
+    return {
+        "peak_allocated_mib": torch.cuda.max_memory_allocated() / 2**20,
+        "peak_reserved_mib": torch.cuda.max_memory_reserved() / 2**20,
+        "whole_gpu_mib": int(used.strip().splitlines()[0]),
+        "host_peak_rss_mib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1024,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--episode", type=Path, required=True)
+    parser.add_argument("--golden", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output = args.output.resolve()
+    args.output.mkdir(parents=True, exist_ok=False)
+    from rlinf.data.datasets.recap.hierarchical_dataset import load_observation
+    from rlinf.data.schema.hierarchical_types import load_episode_json
+    from rlinf.models.embodiment.openpi import get_model
+    from rlinf.models.embodiment.openpi.mem_observation import native_transform_input
+    from rlinf.models.embodiment.openpi.modules.model import preprocess_observation
+    from rlinf.models.embodiment.openpi.recap_lora import (
+        adapter_state_dict,
+        configure_recap_parameters,
+        is_recap_extension_key,
+        legacy_prefix_context,
+        load_adapter_weights,
+        recap_training_manifest,
+    )
+    from rlinf.models.embodiment.openpi.recap_tokenizer import (
+        RecapTokenizer,
+        build_action_prefix,
+        build_high_prefix,
+        canonical_json,
+    )
+    from rlinf.workers.rollout.hf.hierarchical_recap_worker import NativePi05Actor
+    from rlinf.workers.sft.fsdp_hierarchical_recap_worker import (
+        FSDPHierarchicalReCapWorker,
+    )
+
+    cfg = yaml.safe_load(args.config.read_text())
+    episode = load_episode_json(args.episode)
+    torch.set_num_threads(4)
+    torch.manual_seed(20261018)
+    report = {
+        "scope": "excluded_functional_probe_only",
+        "production_training_started": False,
+        "optimizer_steps_probe": 0,
+        "probe_parameters_rolled_back": False,
+        "stages": {},
+        "passed": False,
+        "label_source": "authored_diagnostic_text_and_actual_hold_commands",
+        "policy_success_claimed": False,
+    }
+    model = None
+
+    def save():
+        (args.output / "report.json").write_text(
+            json.dumps(report, ensure_ascii=False, indent=2)
+        )
+
+    def run(name, operation):
+        torch.cuda.empty_cache()
+        torch.cuda.reset_peak_memory_stats()
+        start = time.monotonic()
+        result = operation()
+        report["stages"][name] = {
+            "result": result,
+            "elapsed_s": time.monotonic() - start,
+            "memory": memory(),
+        }
+        save()
+        print(
+            json.dumps({"stage": name, **report["stages"][name]}, ensure_ascii=False),
+            flush=True,
+        )
+        return result
+
+    def group(name):
+        if name.startswith("img."):
+            return "vision"
+        if name.startswith("history_state_proj."):
+            return "history_state"
+        if re.match(r"^llm.layers.\d+.attn.(q_proj|k_proj|v_proj|o_proj).1.", name):
+            return "action_expert"
+        return "vlm"
+
+    def gradients():
+        result = {
+            key: {"tensors": 0, "nonzero_tensors": 0, "l1": 0.0, "finite": True}
+            for key in ("vision", "history_state", "vlm", "action_expert")
+        }
+        frozen = []
+        for name, parameter in model.named_parameters():
+            if parameter.grad is None:
+                continue
+            if not parameter.requires_grad:
+                frozen.append(name)
+            item = result[group(name)]
+            value = parameter.grad.detach().float()
+            amount = float(value.abs().sum())
+            item["tensors"] += 1
+            item["nonzero_tensors"] += int(amount > 0)
+            item["l1"] += amount
+            item["finite"] = item["finite"] and bool(torch.isfinite(value).all())
+        assert not frozen and all(item["finite"] for item in result.values())
+        return result
+
+    try:
+        start = time.monotonic()
+        model = get_model(OmegaConf.create(cfg["model"])).to("cuda:0").eval()
+        original_extensions = {
+            key: value.clone() for key, value in adapter_state_dict(model).items()
+        }
+        base_versions = {
+            name: p._version
+            for name, p in model.named_parameters()
+            if not is_recap_extension_key(name)
+        }
+        report["stages"]["load"] = {
+            "elapsed_s": time.monotonic() - start,
+            "memory": memory(),
+            "strict_base_restore": True,
+            "trainable_parameters": sum(
+                p.numel() for p in model.parameters() if p.requires_grad
+            ),
+            "trainable_by_group": {
+                key: sum(dict(model.named_parameters())[name].numel() for name in names)
+                for key, names in model.recap_parameter_groups.items()
+                if key != "frozen"
+            },
+        }
+        save()
+        print(json.dumps({"stage": "load", **report["stages"]["load"]}), flush=True)
+        tokenizer = RecapTokenizer.from_local_paths(
+            text_tokenizer_path=cfg["tokenizer"]["text_tokenizer_path"],
+            fast_processor_path=cfg["tokenizer"]["fast_processor_path"],
+            max_prefix_tokens=cfg["tokenizer"]["max_prefix_tokens"],
+            max_target_tokens=cfg["tokenizer"]["max_target_tokens"],
+        )
+        actor = NativePi05Actor(
+            model,
+            tokenizer,
+            version="sft_mem_functional_probe",
+            max_new_tokens=16,
+            eos_token_id=tokenizer.eos_token_id,
+            advantage_condition=False,
+        )
+        references = [episode.steps[i].observation for i in (0, 12)]
+        references.append(episode.steps[-1].next_observation)
+
+        def noise():
+            return torch.randn(
+                (1, 16, 32),
+                device="cuda:0",
+                generator=torch.Generator(device="cuda:0").manual_seed(20261018),
+            )
+
+        def parity():
+            cases = []
+            with np.load(args.golden, allow_pickle=False) as golden:
+                for index, reference in enumerate(references):
+                    native = load_observation(reference)
+                    obs = model.env_obs_to_observation(
+                        actor.env_io(native, cfg["rollout"]["goal"])
+                    )
+                    with (
+                        legacy_prefix_context(model, disable_adapters=True),
+                        torch.no_grad(),
+                    ):
+                        actions, _ = model._predict_eval(obs, noise=noise())
+                    actual = actions.float().cpu().numpy()
+                    difference = float(
+                        np.abs(actual - golden[f"actions_{index}"]).max()
+                    )
+                    assert np.allclose(
+                        actual, golden[f"actions_{index}"], atol=1e-5, rtol=1e-5
+                    )
+                    cases.append(
+                        {
+                            "exact_equal": bool(
+                                np.array_equal(actual, golden[f"actions_{index}"])
+                            ),
+                            "max_abs": difference,
+                        }
+                    )
+            return cases
+
+        run("three_original_entry_parities", parity)
+
+        def base(reference):
+            native = load_observation(reference)
+            native["mem_history"] = reference["mem_history"]
+            return native, actor._base_observation(native)
+
+        full_native, full_base = base(references[-1])
+        _, probe_base = base(episode.steps[8].observation)
+        actor_memory = episode.decisions[0].actor_memory
+
+        def prompt_observation(observation, text):
+            ids = torch.as_tensor(
+                tokenizer.encode_prefix(text), device="cuda:0", dtype=torch.long
+            )[None]
+            return dataclasses.replace(
+                observation,
+                tokenized_prompt=ids,
+                tokenized_prompt_mask=torch.ones_like(ids, dtype=torch.bool),
+            )
+
+        action_text = build_action_prefix(
+            task=cfg["rollout"]["goal"],
+            subtask="Hold the current position for an interface check.",
+            state=probe_base.state[0].float().cpu().numpy(),
+            visible_memory=canonical_json(actor_memory),
+            advantage=None,
