+        model.train()
+
+        def backward(name):
+            model.zero_grad(set_to_none=True)
+            output = model.compute_joint_loss({**batch, "loss_weights": {name: 1.0}})
+            value = float(output["loss"].detach())
+            assert torch.isfinite(output["loss"])
+            output["loss"].backward()
+            result = gradients()
